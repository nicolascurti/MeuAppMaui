<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MeuAppMaui.MainPage"
             Title="Meus QR Codes"
             BackgroundColor="#F4F8F5"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="24,28,24,24" Spacing="22">
                <Grid ColumnDefinitions="58,*" ColumnSpacing="14" VerticalOptions="Center">
                    <Image Source="logo.png"
                           HeightRequest="58"
                           WidthRequest="58"
                           Aspect="AspectFill"
                           SemanticProperties.Description="Logo NC em verde e branco" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="MEUS QR CODES"
                               FontSize="13"
                               CharacterSpacing="1.4"
                               FontAttributes="Bold"
                               TextColor="#176B4B" />
                        <Label Text="Compartilhe com facilidade"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#073B2B" />
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout x:Name="QrContent" Spacing="18" IsVisible="False">
                    <VerticalStackLayout.GestureRecognizers>
                        <SwipeGestureRecognizer Direction="Left" Swiped="OnQrSwiped" />
                        <SwipeGestureRecognizer Direction="Right" Swiped="OnQrSwiped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                        <Label x:Name="CurrentTitle"
                               Text="Contato"
                               FontSize="24"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="#073B2B"
                               SemanticProperties.HeadingLevel="Level1" />
                        <Label x:Name="CurrentDescription"
                               Text="Escaneie para abrir"
                               FontSize="14"
                               HorizontalTextAlignment="Center"
                               TextColor="#527064" />
                    </VerticalStackLayout>

                    <Border BackgroundColor="White"
                            Stroke="#DCE9E1"
                            StrokeThickness="1"
                            Padding="16"
                            StrokeShape="RoundRectangle 24"
                            HorizontalOptions="Center">
                        <Image x:Name="QrImage"
                               HeightRequest="270"
                               WidthRequest="270"
                               Aspect="AspectFit"
                               SemanticProperties.Description="QR Code atual" />
                    </Border>

                    <Grid ColumnDefinitions="52,*,52" ColumnSpacing="12" VerticalOptions="Center">
                        <Button x:Name="PreviousButton"
                                Text="‹"
                                FontSize="30"
                                Padding="0"
                                HeightRequest="48"
                                BackgroundColor="#E7F5EE"
                                TextColor="#073B2B"
                                CornerRadius="16"
                                SemanticProperties.Description="Mostrar QR Code anterior"
                                Clicked="OnPreviousClicked" />
                        <Label x:Name="QrCounter"
                               Grid.Column="1"
                               Text="1 de 1"
                               FontSize="14"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"
                               TextColor="#527064" />
                        <Button x:Name="NextButton"
                                Grid.Column="2"
                                Text="›"
                                FontSize="30"
                                Padding="0"
                                HeightRequest="48"
                                BackgroundColor="#E7F5EE"
                                TextColor="#073B2B"
                                CornerRadius="16"
                                SemanticProperties.Description="Mostrar próximo QR Code"
                                Clicked="OnNextClicked" />
                    </Grid>
                    <Label x:Name="SwipeHint"
                           Text="Deslize para alternar entre os QR Codes"
                           FontSize="12"
                           HorizontalTextAlignment="Center"
                           TextColor="#71877C"
                           IsVisible="False" />
                </VerticalStackLayout>

                <Border x:Name="EmptyState"
                        BackgroundColor="White"
                        Stroke="#DCE9E1"
                        StrokeThickness="1"
                        Padding="24"
                        StrokeShape="RoundRectangle 22"
                        IsVisible="False">
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Label Text="Seu primeiro QR Code começa aqui"
                               FontSize="20"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="#073B2B"
                               SemanticProperties.HeadingLevel="Level1" />
                        <Label Text="Adicione seu contato, WhatsApp, LinkedIn ou links nas configurações. Seus dados ficam apenas neste dispositivo."
                               FontSize="15"
                               HorizontalTextAlignment="Center"
                               TextColor="#527064" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Seus dados são armazenados somente neste dispositivo."
                       FontSize="12"
                       HorizontalTextAlignment="Center"
                       TextColor="#71877C" />
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="1"
                Text="⚙  Configurações"
                FontSize="16"
                FontAttributes="Bold"
                Margin="20,8,20,20"
                HeightRequest="54"
                BackgroundColor="#073B2B"
                TextColor="White"
                CornerRadius="18"
                SemanticProperties.Hint="Editar contato, WhatsApp, LinkedIn e links"
                Clicked="OnSettingsClicked" />
    </Grid>
</ContentPage>
